{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "rules": {
        "no-unused-vars": "warn",
        "typescript/no-explicit-any": "warn",
        "no-underscore-dangle": ["warn", { "allow": ["__dirname", "__resetConnectorsForTests"] }]
    },
    "ignorePatterns": ["dist/", "node_modules/", "**/migrations/**", "**/route-map.d.ts"]
}
